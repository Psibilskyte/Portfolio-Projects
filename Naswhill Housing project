SUBSTRING(PropertyAddress, 1,CHARINDEX(',', PropertyAddress)) as Address

From portfolio.dbo.HOUSING

--Removing comma from street name

SELECT
SUBSTRING(PropertyAddress, 1,CHARINDEX(',', PropertyAddress)-1) as Address

From portfolio.dbo.HOUSING

